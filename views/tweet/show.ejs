<div class="wrapper">
  <div class="grid">
    <aside class="rail">
      <%- include('../partials/profile-card', { profile: author, isOwner: currentUser && currentUser.username === author.username, photos: [], followedBy: null }) %>
      <% if (side && side.viewer) { %>
        <%- include('../partials/trends', { side: side }) %>
      <% } %>
      <%- include('../partials/rail-footer') %>
    </aside>

    <main class="content" id="main">
      <% if (ancestors.length > 0) { %>
        <section class="module">
          <div class="stream">
            <% ancestors.forEach(function (item) { %>
              <%- include('../partials/tweet', { tweet: item, context: 'timeline' }) %>
            <% }); %>
          </div>
        </section>
      <% } %>

      <section class="module">
        <div class="permalink-tweet">
          <div class="permalink-header">
            <a href="<%= tweet.author.profileUrl %>"><img src="<%= tweet.author.avatarUrl %>" alt=""></a>
            <div>
              <a class="permalink-name" href="<%= tweet.author.profileUrl %>"><%= tweet.author.displayName %>
                <% if (tweet.author.isVerified) { %>
                  <svg class="verified-badge" role="img" aria-label="Verified account"><use href="#ic-verified"></use></svg>
                <% } %>
                <% if (tweet.author.isAutomated) { %>
                  <svg class="automated-badge" role="img" aria-label="Automated account"><use href="#ic-robot"></use></svg>
                <% } %>
              </a>
              <span class="permalink-handle">@<%= tweet.author.username %></span>
            </div>
            <div style="margin-left:auto;">
              <% if (currentUser && currentUser.username !== tweet.author.username) { %>
                <%- include('../partials/follow-button', { person: author, buttonSize: 'btn-sm' }) %>
              <% } %>
            </div>
          </div>

          <% if (tweet.replyTo) { %>
            <div class="tweet-reply-line" style="margin-top:6px;">in reply to <a href="/<%= tweet.replyTo.username %>">@<%= tweet.replyTo.username %></a></div>
          <% } %>

          <p class="permalink-body"><%- tweet.html %></p>

          <% if (tweet.quoted || tweet.quotedUnavailable) { %>
            <%- include('../partials/quoted-tweet', { quoted: tweet.quoted, unavailable: tweet.quotedUnavailable }) %>
          <% } %>

          <% if (tweet.hasMedia) { %>
            <div class="tweet-media count-<%= tweet.media.length %>">
              <% tweet.media.forEach(function (item) { %>
                <% if (item.isVideo) { %>
                  <video src="<%= item.url %>" controls preload="metadata" playsinline></video>
                <% } else { %>
                  <a href="<%= item.url %>" data-lightbox="<%= item.url %>" data-lightbox-kind="image">
                    <img src="<%= item.url %>" alt="<%= item.alt || ('Photo attached to a Tweet by @' + tweet.author.username) %>">
                  </a>
                <% } %>
              <% }); %>
            </div>
          <% } %>

          <div class="permalink-time">
            <time datetime="<%= tweet.timeIso %>"><%= tweet.timeLong %></time>
          </div>

          <% if (tweet.counts.retweets > 0 || tweet.counts.favorites > 0) { %>
            <div class="tweet-stats">
              <% if (tweet.counts.retweets > 0) { %>
                <span class="stat"><b><%= fmt.fullCount(tweet.counts.retweets) %></b> RETWEETS</span>
              <% } %>
              <% if (tweet.counts.favorites > 0) { %>
                <span class="stat"><b><%= fmt.fullCount(tweet.counts.favorites) %></b> FAVORITES</span>
              <% } %>
            </div>
            <div class="permalink-faces">
              <% faces.forEach(function (person) { %>
                <a href="<%= person.profileUrl %>" title="@<%= person.username %>">
                  <img src="<%= person.avatarUrl %>" alt="@<%= person.username %>">
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div style="padding:0 16px 12px;">
          <div class="tweet-actions is-always-visible" style="gap:30px;">
            <% if (currentUser) { %>
              <a class="tweet-action" href="/compose?in_reply_to=<%= tweet.id %>">
                <svg class="icon icon-sm" aria-hidden="true"><use href="#ic-reply"></use></svg> Reply
              </a>
              <div class="menu menu-retweet" data-menu>
                <a class="tweet-action<%= tweet.viewerRetweeted ? ' is-active' : '' %>"
                   href="/tweets/<%= tweet.id %>/retweet" data-menu-toggle
                   aria-haspopup="true" aria-expanded="false">
                  <svg class="icon icon-sm" aria-hidden="true"><use href="#ic-retweet"></use></svg>
                  <%= tweet.viewerRetweeted ? 'Retweeted' : 'Retweet' %>
                </a>
                <div class="menu-panel" role="menu">
                  <form class="inline-form" method="post"
                        action="/tweets/<%= tweet.id %>/<%= tweet.viewerRetweeted ? 'unretweet' : 'retweet' %>"
                        data-interaction="retweet">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" role="menuitem" data-action="retweet">
                      <%= tweet.viewerRetweeted ? 'Undo Retweet' : 'Retweet' %>
                    </button>
                  </form>
                  <a role="menuitem" href="/compose?quote=<%= tweet.id %>">Quote Tweet</a>
                </div>
              </div>
              <form class="inline-form" method="post"
                    action="/tweets/<%= tweet.id %>/<%= tweet.viewerFavorited ? 'unfavorite' : 'favorite' %>"
                    data-interaction="favorite">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="tweet-action<%= tweet.viewerFavorited ? ' is-active' : '' %>" data-action="favorite">
                  <svg class="icon icon-sm" aria-hidden="true"><use href="#ic-star"></use></svg>
                  <%= tweet.viewerFavorited ? 'Favorited' : 'Favorite' %>
                </button>
              </form>
              <% if (tweet.isOwn) { %>
                <form class="inline-form" method="post" action="/tweets/<%= tweet.id %>/delete"
                      data-confirm="Delete this Tweet? This cannot be undone.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="tweet-action">Delete</button>
                </form>
              <% } else { %>
                <a class="tweet-action" href="/tweets/<%= tweet.id %>/report">
                  <svg class="icon icon-sm" aria-hidden="true"><use href="#ic-flag"></use></svg> Report
                </a>
              <% } %>
            <% } else { %>
              <a class="btn btn-primary btn-sm" href="/login">Sign in to reply</a>
            <% } %>
          </div>
        </div>

        <% if (currentUser) { %>
          <div style="border-top:1px solid var(--border-color);">
            <%- include('../partials/composer', { replyTo: tweet, expanded: true }) %>
          </div>
        <% } %>
      </section>

      <% if (replies.length > 0) { %>
        <section class="module reply-list">
          <div class="timeline-heading">Replies</div>
          <div class="stream">
            <%# A reply to a reply sits under the one it answers, stepped in.
                The step stops at four so a long argument cannot walk the
                column off the side of the page. %>
            <% replies.forEach(function (item) { %>
              <div class="reply-depth-<%= Math.min(item.threadDepth, 4) %>">
                <%- include('../partials/tweet', { tweet: item, context: 'timeline' }) %>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>
    </main>
  </div>
</div>
