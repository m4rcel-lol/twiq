<div class="wrapper">
  <div class="grid">
    <aside class="rail">
      <%- include('../partials/rail', { side: side, railComposer: false }) %>
    </aside>
    <main class="content" id="main">
      <section class="module">
        <div class="timeline-heading">Follower requests</div>
        <div class="people-list">
          <% if (requests.length === 0) { %>
            <div class="empty-state"><strong>No pending requests</strong>People who ask to follow you will show up here.</div>
          <% } %>
          <% requests.forEach(function (person) { %>
            <div class="person">
              <a href="<%= person.profileUrl %>"><img src="<%= person.avatarUrl %>" alt=""></a>
              <div class="person-body">
                <a class="person-name" href="<%= person.profileUrl %>"><%= person.displayName %></a>
                <a class="person-handle" href="<%= person.profileUrl %>">@<%= person.username %></a>
                <% if (person.bioHtml) { %><div class="person-bio"><%- person.bioHtml %></div><% } %>
              </div>
              <div class="person-actions" style="display:flex;gap:5px;">
                <form class="inline-form" method="post" action="/<%= person.username %>/approve">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-primary btn-sm">Accept</button>
                </form>
                <form class="inline-form" method="post" action="/<%= person.username %>/deny">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm">Decline</button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    </main>
  </div>
</div>
