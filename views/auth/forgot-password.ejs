<div class="auth-shell">
  <div class="brand"><a href="/"><img src="/images/logo.svg" alt="<%= brand.name %>" height="34"></a></div>
  <div class="auth-card">
    <h1>Reset your password</h1>
    <% if (sent) { %>
      <div class="flash flash-success">
        If that account exists, we have sent a reset link to its email address.
        The link is good for one hour.
      </div>
      <a class="btn btn-block" href="/login">Back to sign in</a>
    <% } else { %>
      <%- include('../partials/form-errors', { errors: errors }) %>
      <p style="font-size:13px;color:var(--muted-text);">
        Enter your username or email address and we will send you a link to choose a new password.
      </p>
      <form method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <label class="form-label" for="identifier">Username or email</label>
          <input id="identifier" type="text" name="identifier" maxlength="254" required autofocus>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/page-footer') %>
