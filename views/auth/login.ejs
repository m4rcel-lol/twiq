<div class="auth-shell">
  <div class="brand">
    <a href="/" aria-label="<%= brand.name %> home">
      <img src="/images/logo.svg" alt="<%= brand.name %>" height="34">
    </a>
  </div>
  <div class="auth-card">
    <h1>Sign in to <%= brand.name %></h1>
    <%- include('../partials/form-errors', { errors: errors }) %>
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (redirect) { %><input type="hidden" name="redirect" value="<%= redirect %>"><% } %>
      <div class="form-row">
        <label class="form-label" for="identifier">Username or email</label>
        <input id="identifier" type="text" name="identifier" maxlength="254" required
               autocomplete="username" value="<%= values.identifier || '' %>" autofocus>
      </div>
      <div class="form-row">
        <label class="form-label" for="password">Password</label>
        <input id="password" type="password" name="password" required autocomplete="current-password">
      </div>
      <div class="checkbox-row">
        <input id="remember" type="checkbox" name="remember" checked>
        <label for="remember">Remember me</label>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Sign in</button>
    </form>
    <div class="auth-alt"><a href="/forgot-password">Forgot your password?</a></div>
  </div>
  <% if (registrationEnabled) { %>
    <div class="auth-alt">New to <%= brand.name %>? <a href="/register">Sign up</a></div>
  <% } %>
</div>
<%- include('../partials/page-footer') %>
