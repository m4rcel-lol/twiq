<%# The Tweet a quote points at, rendered small inside it. Not a copy: it is
    read live, so an edit or a deletion of the original shows up here. %>
<% if (unavailable) { %>
  <div class="quoted-tweet is-unavailable">This Tweet is unavailable.</div>
<% } else { %>
  <a class="quoted-tweet" href="<%= quoted.permalink %>">
    <span class="quoted-header">
      <img class="quoted-avatar" src="<%= quoted.author.avatarUrl %>" alt="" width="16" height="16">
      <b class="quoted-name"><%= quoted.author.displayName %></b>
      <% if (quoted.author.isVerified) { %>
        <svg class="verified-badge" role="img" aria-label="Verified account"><use href="#ic-verified"></use></svg>
      <% } %>
      <% if (quoted.author.isAutomated) { %>
        <svg class="automated-badge" role="img" aria-label="Automated account"><use href="#ic-robot"></use></svg>
      <% } %>
      <span class="quoted-handle">@<%= quoted.author.username %></span>
      <span class="quoted-time"><%= quoted.timeShort %></span>
    </span>
    <span class="quoted-body"><%= quoted.snippet %></span>
    <% if (quoted.hasMedia) { %>
      <span class="quoted-media-note">
        <svg class="icon icon-sm" aria-hidden="true"><use href="#ic-camera"></use></svg>
        <%= quoted.media.length %> attached
      </span>
    <% } %>
  </a>
<% } %>
