# ---------------------------------------------------------------------------
# Twiq - environment configuration
# Copy to `.env` and edit. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public base URL (used for canonical links, Open Graph tags, e-mail links)
BASE_URL=https://twiq.example.com

# PostgreSQL. Inside docker compose the host is the `postgres` service name.
DATABASE_URL=postgres://twiq:twiq_password@postgres:5432/twiq
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000

# Used only by docker compose to initialise the postgres container
POSTGRES_USER=twiq
POSTGRES_PASSWORD=twiq_password
POSTGRES_DB=twiq

# Sessions - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_NAME=twiq.sid
SESSION_TTL_HOURS=720
SECURE_COOKIES=true

# Reverse proxy. Caddy runs on the host, so trust the first proxy hop.
TRUST_PROXY=1

# Uploads
UPLOAD_DIR=/app/public/uploads
MAX_UPLOAD_SIZE=15728640
UPLOAD_PUBLIC_PATH=/uploads
STORAGE_DRIVER=local

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Tweet length. The database allows up to 300 (migration 003); raising this
# beyond that needs a new migration widening the tweets_body_length check.
TWEET_MAX_LENGTH=300

# Feature flags
ENABLE_WEBSOCKETS=true
ENABLE_REGISTRATION=true

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_TWEET_MAX=60
RATE_LIMIT_DM_MAX=120
RATE_LIMIT_UPLOAD_MAX=60

# Bootstrap administrator (applied by `npm run seed`)
ADMIN_USERNAME=twiq
ADMIN_EMAIL=admin@twiq.example.com
ADMIN_PASSWORD=change-this-password
